{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "post-gura",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "post-gura.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["41 18 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "post-gura",
      "database_id": "e33d5c00-55d4-4e00-a305-0abdbec155cf",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
